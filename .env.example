# ==== このファイルを .env にコピーしてローカルテストに使う ====
# 本番(GitHub Actions)ではこれらを GitHub Secrets に登録する(.envはコミットしない)

# --- Anthropic API (文章生成・品質審査) https://console.anthropic.com/ で取得 ---
# 注意: Claude Codeの月額契約とは別課金のAPIキーが必要です
ANTHROPIC_API_KEY=

# --- OpenAI API (画像生成: gpt-image-1) https://platform.openai.com/ で取得 ---
OPENAI_API_KEY=

# --- Instagram API with Instagram Login (Facebookページ連携なし) ---
# 取得手順はREADME.md参照。scripts/setup_helper.py で取得を補助
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- ブランド/CTA設定 ---
BRAND_HANDLE=@leap_connect
BRAND_DISPLAY_NAME=首都圏オーナー相談室
COMPANY_NAME=
LP_URL=
# LP_URLに付与するUTM(任意)
UTM_PARAMS=utm_source=instagram&utm_medium=social&utm_campaign=organic_post

# --- 運用設定 ---
# DRY_RUN=1 で生成のみ行い、Instagramへの実投稿とDB更新をスキップ
DRY_RUN=1
